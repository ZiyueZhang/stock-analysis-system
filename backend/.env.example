# Required: Tavily web search
TAVILY_API_KEY=

# Required: LLM provider API key (DeepSeek/OpenAI compatible)
LLM_API_KEY=

# Optional: Override OpenAI-compatible base URL
LLM_BASE_URL=https://api.deepseek.com/v1

# Optional: Default model name
LLM_MODEL=deepseek-chat

# Required in production (optional in dev): Fernet key for encrypting stored API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Alternative to ENCRYPTION_KEY: read the Fernet key from a file
# ENCRYPTION_KEY_FILE=/path/to/fernet.key
ENCRYPTION_KEY_FILE=

# If ENCRYPTION_KEY/ENCRYPTION_KEY_FILE are not set, backend will fail-fast by default.
# Set this to true ONLY for local development if you accept that encrypted DB data will be unrecoverable after restart.
ALLOW_EPHEMERAL_ENCRYPTION_KEY=false

# Optional: Database URL (defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./stock_analysis.db
